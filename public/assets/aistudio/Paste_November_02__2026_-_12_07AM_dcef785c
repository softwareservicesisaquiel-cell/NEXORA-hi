<script>
  (function() {
    // Like Interaction Logic
    const likeBtn = document.getElementById('like-btn');
    const likeIcon = document.getElementById('like-icon');
    const likeCount = document.getElementById('like-count');
    const heartBurst = document.getElementById('heart-burst');
    const mediaContainer = document.getElementById('reel-media');
    let isLiked = false;
    let likes = 48200;

    function triggerLikeAnimation() {
      if (!isLiked) {
        isLiked = true;
        likes += 1;
        likeIcon.style.fontVariationSettings = "'FILL' 1";
        likeBtn.classList.add('text-tertiary-container');
        likeIcon.classList.add('text-tertiary-container');
        likeCount.textContent = (likes / 1000).toFixed(1) + 'K';
      }
      // Trigger center screen burst
      heartBurst.classList.remove('opacity-0', 'scale-50');
      heartBurst.classList.add('opacity-100', 'scale-110');
      setTimeout(() => {
        heartBurst.classList.remove('opacity-100', 'scale-110');
        heartBurst.classList.add('opacity-0', 'scale-50');
      }, 500);
    }

    likeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!isLiked) {
        triggerLikeAnimation();
      } else {
        isLiked = false;
        likes -= 1;
        likeIcon.style.fontVariationSettings = "'FILL' 0";
        likeBtn.classList.remove('text-tertiary-container');
        likeIcon.classList.remove('text-tertiary-container');
        likeCount.textContent = (likes / 1000).toFixed(1) + 'K';
      }
    });

    // Double click / tap gesture on reel media
    let lastTap = 0;
    mediaContainer.parentElement.addEventListener('click', (e) => {
      // Don't trigger if clicked on control buttons
      if (e.target.closest('button')) return;
      const currentTime = new Date().getTime();
      const tapLength = currentTime - lastTap;
      if (tapLength < 300 && tapLength > 0) {
        triggerLikeAnimation();
      }
      lastTap = currentTime;
    });

    // Bookmark Interaction
    const bookmarkBtn = document.getElementById('bookmark-btn');
    const bookmarkIcon = document.getElementById('bookmark-icon');
    let isBookmarked = false;
    bookmarkBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      isBookmarked = !isBookmarked;
      bookmarkIcon.style.fontVariationSettings = isBookmarked ? "'FILL' 1" : "'FILL' 0";
      bookmarkBtn.classList.toggle('text-primary', isBookmarked);
    });

    // Follow Quick Badge
    const followBadge = document.getElementById('follow-badge-btn');
    const followIcon = document.getElementById('follow-icon');
    let isFollowing = false;
    followBadge.addEventListener('click', (e) => {
      e.stopPropagation();
      isFollowing = !isFollowing;
      if (isFollowing) {
        followIcon.textContent = 'check';
        followBadge.classList.replace('bg-primary-container', 'bg-secondary');
        followBadge.classList.replace('text-on-primary-container', 'text-on-secondary');
      } else {
        followIcon.textContent = 'add';
        followBadge.classList.replace('bg-secondary', 'bg-primary-container');
        followBadge.classList.replace('text-on-secondary', 'text-on-primary-container');
      }
    });

    // Mute / Unmute Sound Toggle
    const muteBtn = document.getElementById('mute-toggle-btn');
    const muteIcon = document.getElementById('mute-icon');
    const audioDisc = document.getElementById('audio-disc');
    let isMuted = false;
    muteBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      isMuted = !isMuted;
      muteIcon.textContent = isMuted ? 'volume_off' : 'volume_up';
      audioDisc.style.animationPlayState = isMuted ? 'paused' : 'running';
    });

    // Caption Read More toggle
    const toggleCaptionBtn = document.getElementById('toggle-caption-btn');
    const captionText = document.getElementById('caption-text');
    let isExpanded = false;
    toggleCaptionBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      isExpanded = !isExpanded;
      captionText.classList.toggle('line-clamp-2', !isExpanded);
      toggleCaptionBtn.textContent = isExpanded ? 'menos' : 'mais';
    });

    // Tab Switch (A Seguir / Para Ti)
    const tabFollowing = document.getElementById('tab-following');
    const tabForYou = document.getElementById('tab-foryou');
    tabFollowing.addEventListener('click', () => {
      tabFollowing.classList.replace('text-on-surface-variant', 'text-secondary');
      tabFollowing.classList.add('bg-surface-variant/70', 'font-bold');
      tabForYou.classList.replace('text-secondary', 'text-on-surface-variant');
      tabForYou.classList.remove('bg-surface-variant/70', 'font-bold');
    });
    tabForYou.addEventListener('click', () => {
      tabForYou.classList.replace('text-on-surface-variant', 'text-secondary');
      tabForYou.classList.add('bg-surface-variant/70', 'font-bold');
      tabFollowing.classList.replace('text-secondary', 'text-on-surface-variant');
      tabFollowing.classList.remove('bg-surface-variant/70', 'font-bold');
    });

    // Simulated Progress Scrub Animation
    const progressBar = document.getElementById('video-progress');
    let progress = 40;
    setInterval(() => {
      progress = (progress + 0.5) % 100;
      progressBar.style.width = progress + '%';
    }, 200);

    // Comments Sheet Overlay Open/Close
    const commentTrigger = document.getElementById('comment-trigger');
    const commentsSheet = document.getElementById('comments-sheet');
    const closeComments = document.getElementById('close-comments');
    commentTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      commentsSheet.classList.remove('hidden');
    });
    closeComments.addEventListener('click', (e) => {
      e.stopPropagation();
      commentsSheet.classList.add('hidden');
    });
  })();
