      "url": "/?tab=clips",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Mensagens Diretas",
      "short_name": "Chat",
      "description": "Conversas privadas protegidas",
      "url": "/?tab=messages",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Explorar Conteúdo",
